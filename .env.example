# Database connection (Neon Postgres)
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES=10m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=30m

# Environment
NODE_ENV=production

# Server port (Render injects PORT automatically — do not set it there)
PORT=5000

# Files (Media) — Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mailing — Gmail SMTP (legacy) + Resend
MAIL_USER=
MAIL_PASS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFIED_PHONE_NUMBER=

# Frontend password-reset link base
CLIENT_NEW_PASSWORD_URL=

# CRON Jobs Condition
RUN_SCHEDULER=true
