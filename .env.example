# Database connection (Neon Postgres)
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES=10m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=30m

# Environment
NODE_ENV=production

# Server port (Render injects PORT automatically — do not set it there)
PORT=5000

# Files (Media) — Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mailing — Gmail SMTP (legacy) + Resend
MAIL_USER=
MAIL_PASS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFIED_PHONE_NUMBER=

# Frontend password-reset link base
CLIENT_NEW_PASSWORD_URL=

# CRON Jobs Condition
RUN_SCHEDULER=true

# AgroTrack integration — shared secrets with AgroTrack Django, matching
# its OKO_SERVICE_API_KEY / OKO_SERVICE_HMAC_SECRET / OKO_WEBHOOK_SECRET.
# Leave AGROTRACK_API_KEY/AGROTRACK_HMAC_SECRET unset to disable outbound
# AgroTrack calls; leave AGROTRACK_WEBHOOK_SECRET unset and the inbound
# webhook receiver rejects every request (no calls succeed, nothing else
# in the app is affected).
AGROTRACK_BASE_URL=
AGROTRACK_API_KEY=
AGROTRACK_HMAC_SECRET=
AGROTRACK_WEBHOOK_SECRET=
